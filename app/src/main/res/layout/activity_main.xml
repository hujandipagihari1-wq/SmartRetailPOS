<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Kalkulator Kasir"
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="#0F172A" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Latihan runCatching + Timber Debugging"
            android:textSize="13sp"
            android:textColor="#64748B"
            android:layout_marginBottom="20dp" />

        <EditText
            android:id="@+id/etNominal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Nominal Harga Barang (Rupiah)"
            android:inputType="numberDecimal"
            android:importantForAutofill="no"
            android:textSize="14sp" />

        <EditText
            android:id="@+id/etQty"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:hint="Jumlah Barang"
            android:inputType="number"
            android:importantForAutofill="no"
            android:textSize="14sp" />

        <Button
            android:id="@+id/btnHitung"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Hitung Total"
            android:backgroundTint="#0D9488"
            android:textColor="#FFFFFF" />

        <TextView
            android:id="@+id/tvHasil"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:padding="16dp"
            android:background="#F1F5F9"
            android:text="Tekan tombol di atas untuk memulai kalkulasi."
            android:textSize="14sp"
            android:textColor="#0F172A" />

        <!-- Navigasi ke Tahap 2 -->
        <Button
            android:id="@+id/btnOpenPos"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="Buka Terminal Kasir (Tahap 2)"
            android:backgroundTint="#334155"
            android:textColor="#FFFFFF" />

    </LinearLayout>
</ScrollView>