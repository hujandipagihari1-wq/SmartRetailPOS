<?xml version="1.0" encoding="utf-8"?>

<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/coordinatorLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#EEF2FF">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="18dp">

            <!-- HEADER -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="POS TERMINAL"
                android:textSize="24sp"
                android:textStyle="bold"
                android:textColor="#1E1B4B"
                android:letterSpacing="0.08" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Sistem pembayaran dan simulasi transaksi"
                android:textSize="13sp"
                android:textColor="#6366F1"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="18dp" />

            <!-- INPUT TRANSAKSI -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="16dp"
                app:cardElevation="2dp"
                app:strokeColor="#E0E7FF"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="DATA TRANSAKSI"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:textColor="#4F46E5"
                        android:letterSpacing="0.06"
                        android:layout_marginBottom="12dp" />

                    <EditText
                        android:id="@+id/etBarcode"
                        android:layout_width="match_parent"
                        android:layout_height="52dp"
                        android:hint="Masukkan barcode produk"
                        android:background="@android:drawable/editbox_background"
                        android:paddingHorizontal="14dp"
                        android:inputType="text"
                        android:importantForAutofill="no"
                        android:textSize="14sp" />

                    <EditText
                        android:id="@+id/etTotalBelanja"
                        android:layout_width="match_parent"
                        android:layout_height="52dp"
                        android:layout_marginTop="12dp"
                        android:hint="Total belanja (Rupiah)"
                        android:background="@android:drawable/editbox_background"
                        android:paddingHorizontal="14dp"
                        android:inputType="numberDecimal"
                        android:importantForAutofill="no"
                        android:textSize="14sp" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- SIMULATION -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="PILIH SKENARIO"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="#475569"
                android:letterSpacing="0.06"
                android:layout_marginTop="22dp"
                android:layout_marginBottom="8dp" />

            <RadioGroup
                android:id="@+id/rgSimulation"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="#FFFFFF"
                android:padding="12dp">

                <RadioButton
                    android:id="@+id/rbSuccess"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Transaksi normal — berhasil"
                    android:textSize="14sp"
                    android:textColor="#1E293B"
                    android:checked="true"
                    android:paddingVertical="5dp" />

                <RadioButton
                    android:id="@+id/rbBarcodeError"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Error 404 — barcode tidak ditemukan"
                    android:textSize="14sp"
                    android:textColor="#1E293B"
                    android:paddingVertical="5dp" />

                <RadioButton
                    android:id="@+id/rbNetworkTimeout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Error jaringan — payment timeout"
                    android:textSize="14sp"
                    android:textColor="#1E293B"
                    android:paddingVertical="5dp" />

                <RadioButton
                    android:id="@+id/rbLimitExceeded"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Melewati limit — perlu supervisor"
                    android:textSize="14sp"
                    android:textColor="#1E293B"
                    android:paddingVertical="5dp" />

            </RadioGroup>

            <!-- PROCESS BUTTON -->
            <Button
                android:id="@+id/btnProcessPayment"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:text="PROSES TRANSAKSI"
                android:textSize="14sp"
                android:textStyle="bold"
                android:backgroundTint="#4F46E5"
                android:textColor="#FFFFFF"
                android:layout_marginTop="16dp" />

            <!-- LOADING -->
            <ProgressBar
                android:id="@+id/pbPosLoading"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_marginTop="18dp"
                android:visibility="gone" />

            <!-- RESULT -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardPosResult"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:visibility="gone"
                app:cardCornerRadius="16dp"
                app:cardElevation="2dp"
                app:strokeColor="#C7D2FE"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="18dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="HASIL TRANSAKSI"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:textColor="#6366F1"
                        android:letterSpacing="0.06" />

                    <TextView
                        android:id="@+id/tvPosStatus"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="TRANSAKSI BERHASIL"
                        android:textSize="17sp"
                        android:textStyle="bold"
                        android:textColor="#16A34A"
                        android:layout_marginTop="8dp" />

                    <TextView
                        android:id="@+id/tvPosDetails"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Detail transaksi akan tampil di sini..."
                        android:textSize="13sp"
                        android:textColor="#334155"
                        android:layout_marginTop="8dp" />

                    <TextView
                        android:id="@+id/tvRetryCounter"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Percobaan koneksi: 0 dari 3"
                        android:textSize="11sp"
                        android:textColor="#64748B"
                        android:layout_marginTop="10dp"
                        android:visibility="gone" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>

    </ScrollView>

</androidx.coordinatorlayout.widget.CoordinatorLayout>